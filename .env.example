# Configuration de Frigg. Copier ce fichier en .env (jamais commité) et adapter.
# Les variables déjà présentes dans l'environnement priment sur ce fichier.

# Chemin du fichier SQLite.
FRIGG_DATABASE_PATH=./data/frigg.db
# Répertoire des fichiers déposés (à sauvegarder avec la base).
FRIGG_DATA_DIR=./data/files
# Adresse d'écoute du serveur HTTP.
FRIGG_LISTEN_ADDR=:8080
# URL publique de Frigg, utilisée dans les liens des e-mails (obligatoire pour serve).
# En développement, l'URL du serveur Vite.
FRIGG_BASE_URL=http://localhost:5173
# Cookies de session Secure. À laisser à true, sauf accès HTTP hors localhost.
FRIGG_COOKIE_SECURE=true
# Adresses IP des reverse proxies de confiance (séparées par des virgules) :
# X-Forwarded-For n'est lu que pour elles.
FRIGG_TRUSTED_PROXIES=

# Serveur SMTP (FRIGG_SMTP_HOST obligatoire pour serve). Valeurs pour Mailpit
# (docker compose up -d).
FRIGG_SMTP_HOST=localhost
FRIGG_SMTP_PORT=1025
FRIGG_SMTP_USERNAME=
FRIGG_SMTP_PASSWORD=
# starttls, tls ou none.
FRIGG_SMTP_TLS=none
# Expéditeur des e-mails (obligatoire pour serve).
FRIGG_MAIL_FROM=frigg@localhost
# Intervalle de dépilage de la file d'e-mails.
FRIGG_MAIL_POLL_INTERVAL=30s

# Niveau de journalisation : debug, info, warn, error.
FRIGG_LOG_LEVEL=info
# Documentation d'API de développement (/api/docs), réservée aux administrateurs.
# Ne jamais activer en production.
FRIGG_API_DOCS=false
