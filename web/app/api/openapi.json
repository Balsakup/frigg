{
  "components": {
    "schemas": {
      "Account": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string"
          },
          "emailVerified": {
            "type": "boolean"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "role": {
            "enum": [
              "member",
              "admin"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "role",
          "emailVerified"
        ],
        "type": "object"
      },
      "AdminAccount": {
        "additionalProperties": false,
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "disabledAt": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "email": {
            "type": "string"
          },
          "emailVerified": {
            "type": "boolean"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "isSelf": {
            "description": "Compte de l'administrateur connecté",
            "type": "boolean"
          },
          "lastLoginAt": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "enum": [
              "member",
              "admin"
            ],
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "disabled"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "role",
          "status",
          "emailVerified",
          "createdAt",
          "lastLoginAt",
          "disabledAt",
          "isSelf"
        ],
        "type": "object"
      },
      "AdminAccountPage": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AdminAccount"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "page": {
            "format": "int64",
            "type": "integer"
          },
          "pageSize": {
            "format": "int64",
            "type": "integer"
          },
          "total": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "pageSize"
        ],
        "type": "object"
      },
      "Association": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "ChangePasswordInputBody": {
        "additionalProperties": false,
        "properties": {
          "currentPassword": {
            "description": "Mot de passe actuel",
            "maxLength": 1024,
            "type": "string"
          },
          "newPassword": {
            "description": "Au moins 8 caractères, dont une majuscule et un chiffre",
            "maxLength": 1024,
            "type": "string"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "type": "object"
      },
      "CreateInvitationInputBody": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "description": "Adresse électronique de la personne invitée",
            "maxLength": 254,
            "type": "string"
          },
          "role": {
            "default": "member",
            "description": "Rôle du futur compte",
            "enum": [
              "member",
              "admin"
            ],
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "type": "object"
      },
      "EmailInputBody": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "description": "Adresse électronique",
            "maxLength": 254,
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Invitation": {
        "additionalProperties": false,
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "invitedBy": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "enum": [
              "member",
              "admin"
            ],
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "expired"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "role",
          "status",
          "expiresAt",
          "invitedBy",
          "createdAt"
        ],
        "type": "object"
      },
      "InvitationListOutputBody": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Invitation"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "InvitationPreviewOutputBody": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string"
          },
          "role": {
            "enum": [
              "member",
              "admin"
            ],
            "type": "string"
          }
        },
        "required": [
          "email",
          "role"
        ],
        "type": "object"
      },
      "LoginInputBody": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "description": "Adresse électronique",
            "maxLength": 254,
            "type": "string"
          },
          "password": {
            "description": "Mot de passe",
            "maxLength": 1024,
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "PasswordTokenInputBody": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "description": "Au moins 8 caractères, dont une majuscule et un chiffre",
            "maxLength": 1024,
            "type": "string"
          },
          "token": {
            "description": "Jeton reçu par e-mail",
            "maxLength": 128,
            "type": "string"
          }
        },
        "required": [
          "token",
          "password"
        ],
        "type": "object"
      },
      "Session": {
        "additionalProperties": false,
        "properties": {
          "account": {
            "$ref": "#/components/schemas/Account"
          },
          "association": {
            "$ref": "#/components/schemas/Association"
          }
        },
        "required": [
          "account",
          "association"
        ],
        "type": "object"
      },
      "SetAccountRoleInputBody": {
        "additionalProperties": false,
        "properties": {
          "role": {
            "description": "Nouveau rôle",
            "enum": [
              "member",
              "admin"
            ],
            "type": "string"
          }
        },
        "required": [
          "role"
        ],
        "type": "object"
      },
      "TokenInputBody": {
        "additionalProperties": false,
        "properties": {
          "token": {
            "description": "Jeton reçu par e-mail",
            "maxLength": 128,
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "session": {
        "in": "cookie",
        "name": "frigg_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "Frigg API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/admin/accounts": {
      "get": {
        "operationId": "list-accounts",
        "parameters": [
          {
            "description": "Fragments d'adresse d'au moins 3 caractères, séparés par des espaces, tous requis",
            "explode": false,
            "in": "query",
            "name": "q",
            "schema": {
              "description": "Fragments d'adresse d'au moins 3 caractères, séparés par des espaces, tous requis",
              "maxLength": 100,
              "type": "string"
            }
          },
          {
            "description": "Filtre sur le rôle",
            "explode": false,
            "in": "query",
            "name": "role",
            "schema": {
              "description": "Filtre sur le rôle",
              "enum": [
                "member",
                "admin"
              ],
              "type": "string"
            }
          },
          {
            "description": "Filtre sur l'état",
            "explode": false,
            "in": "query",
            "name": "status",
            "schema": {
              "description": "Filtre sur l'état",
              "enum": [
                "active",
                "disabled"
              ],
              "type": "string"
            }
          },
          {
            "description": "Numéro de page",
            "explode": false,
            "in": "query",
            "name": "page",
            "schema": {
              "default": 1,
              "description": "Numéro de page",
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Nombre de comptes par page",
            "explode": false,
            "in": "query",
            "name": "pageSize",
            "schema": {
              "default": 25,
              "description": "Nombre de comptes par page",
              "format": "int64",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminAccountPage"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Comptes de l'association",
        "tags": [
          "Comptes"
        ]
      }
    },
