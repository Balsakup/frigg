{{define "body"}}<p style="margin:0 0 12px">Bonjour,</p>
<p style="margin:0 0 12px">L'inscription à <strong>{{.Event}}</strong> est confirmée pour :</p>
<ul style="margin:0 0 12px">{{range .Members}}<li>{{.}}</li>{{end}}</ul>
<p style="margin:0 0 12px">Date : {{.When}}<br>Lieu : {{.Location}}</p>
{{if .Link}}<p style="margin:0 0 12px">Montant à régler : <strong>{{.Amount}}</strong><br>Référence de paiement : <strong>{{.Reference}}</strong></p>
<p style="margin:0 0 20px"><a href="{{.Link}}" style="{{template "button-style"}}">Payer l'inscription</a></p>
<p style="margin:0 0 12px;color:#525a67;font-size:14px">Si le bouton ne fonctionne pas, copiez cette adresse dans votre navigateur :<br><span style="word-break:break-all">{{.Link}}</span></p>{{end}}
<p style="margin:0 0 12px">Pour annuler, rendez-vous dans « Mes inscriptions » avant la clôture des inscriptions.</p>{{end}}
